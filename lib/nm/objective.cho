edition 7;

module opt.objective;

import std.buffer;
import std.fmt;
import std.io;
import std.json;
import std.option;
import std.process;
import opt.persist;

// The objective: one of three built in, or a program that is started for each point (docs/design.md section 4).
//
// `value` answers (code, value): 0 and the number, or 1 (the program could not be started), 2 (it did not exit with status 0),
// 3 (its output is not exactly one number), 4 (the number is not finite).

pub fn kind_program() -> [] int {
    return 0;
}

pub fn kind_sphere() -> [] int {
    return 1;
}

pub fn kind_rosenbrock() -> [] int {
    return 2;
}

pub fn kind_quadratic() -> [] int {
    return 3;
}

pub fn kind_absolute() -> [] int {
    return 4;
}

// a program started once that answers a line for each line it is given (`--persistent`, docs/design.md section 14)
pub fn kind_persistent() -> [] int {
    return 5;
}

// The kind named `name`, or -1.
pub fn kind_of[&s](name: &s [byte]) -> [] int {
    if len(name) == 6 && name[0] == byte_of('s') && name[1] == byte_of('p') {
        return 1;
    }
    if len(name) == 10 && name[0] == byte_of('r') {
        return 2;
    }
    if len(name) == 9 && name[0] == byte_of('q') {
        return 3;
    }
    if len(name) == 8 && name[0] == byte_of('a') {
        return 4;
    }
    return 0 - 1;
}

fn status_of(ran: process.Ran) -> [] int {
    match ran {
        process.Ran::Code(n) => {
            return n;
        }
        process.Ran::Signaled(s) => {
            return 0 - 4;
        }
        process.Ran::TimedOut => {
            return 255;
        }
        process.Ran::TooMuch => {
            return 255;
        }
        process.Ran::Failed(e) => {
            return 255;
        }
    }
}

// the first whitespace-separated token of `text` and whether more than one was there: the number it holds, by way of the JSON reader
fn number_of[&s](text: &s [byte]) -> [] (int, float) {
    var first = 0;
    while first < len(text) && (int_of(text[first]) == ' ' || int_of(text[first]) == 10 || int_of(text[first]) == 13 || int_of(text[first]) == 9) {
        first = first + 1;
    }
    var last = first;
    while last < len(text) && int_of(text[last]) != ' ' && int_of(text[last]) != 10 && int_of(text[last]) != 13 && int_of(text[last]) != 9 {
        last = last + 1;
    }
    var rest = last;
    while rest < len(text) && (int_of(text[rest]) == ' ' || int_of(text[rest]) == 10 || int_of(text[rest]) == 13 || int_of(text[rest]) == 9) {
        rest = rest + 1;
    }
    if last == first || rest < len(text) {
        return (3, 0.0);
    }
    var code = 3;
    var out = 0.0;
    region r {
        let src = alloc_slice[r](last - first + 2, byte_of(0));
        src[0] = byte_of('[');
        var k = first;
        while k < last {
            src[1 + k - first] = text[k];
            k = k + 1;
        }
        src[last - first + 1] = byte_of(']');
        let all = src[0..last - first + 2];
        let tape = alloc_slice[r](json.tape_len(all), 0);
        if json.parse(all, tape) > 0 && json.is_number(tape, 1) {
            out = json.to_float(all, tape, 1);
            code = 0;
        }
    }
    if code == 0 && out - out != 0.0 {
        return (4, 0.0);
    }
    return (code, out);
}

fn spawn_value[&h, &i, &x, &c, &p, &a, &v](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, exe: &p [byte], argv: &a [byte], point: &v [float]) -> [heap, exec(""), clock, poll] (int, float) {
    var line = buffer.empty(heap, 64);
    var k = 0;
    while k < len(point) {
        if k > 0 {
            line = buffer.push(heap, line, byte_of(' '));
        }
        region r {
            let scratch = alloc_slice[r](32, byte_of(0));
            let n = fmt.float_into(scratch, point[k]);
            if n > 0 {
                line = buffer.append(heap, line, scratch[0..n]);
            }
        }
        k = k + 1;
    }
    line = buffer.push(heap, line, byte_of(10));
    var code = 1;
    var out = 0.0;
    match process.channels_with_errors() {
        process.ChannelsWithErrors::Failed(e) => {
            code = 1;
        }
        process.ChannelsWithErrors::Ok(to_child, child_in, from_child, child_out, from_errors, child_errors) => {
            match exec_spawn(exec, exe, argv, "PATH=/usr/local/bin:/usr/bin:/bin\0HOME=/tmp\0", Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Pipe(child_errors)) {
                Spawned::Failed(e) => {
                    process.close(to_child, from_child);
                    pipe_close(from_errors);
                    code = 1;
                }
                Spawned::Ok(child) => {
                    var input = buffer.empty(heap, 0);
                    borrow line as &lr in {
                        input = buffer.append(heap, input, buffer.bytes(lr));
                    }
                    borrow input as &nr in {
                        let (got, errors, ran) = process.capture_both(heap, clock, child, to_child, from_child, from_errors, buffer.bytes(nr), 65536, 65536, 3600000);
                        if status_of(ran) != 0 {
                            code = 2;
                        } else {
                            borrow got as &gr in {
                                let (c2, v2) = number_of(buffer.bytes(gr));
                                code = c2;
                                out = v2;
                            }
                        }
                        buffer.drop(heap, got);
                        buffer.drop(heap, errors);
                    }
                    buffer.drop(heap, input);
                }
            }
        }
    }
    buffer.drop(heap, line);
    return (code, out);
}

// the line that asks for the value at `point`: its numbers in the shortest form that reads back, one space apart, one newline
fn point_line[&h, &v](heap: &!h Heap, point: &v [float]) -> [heap] buffer.Buffer {
    var line = buffer.empty(heap, 64);
    var k = 0;
    while k < len(point) {
        if k > 0 {
            line = buffer.push(heap, line, byte_of(' '));
        }
        region r {
            let scratch = alloc_slice[r](32, byte_of(0));
            let n = fmt.float_into(scratch, point[k]);
            if n > 0 {
                line = buffer.append(heap, line, scratch[0..n]);
            }
        }
        k = k + 1;
    }
    return buffer.push(heap, line, byte_of(10));
}

// One request on the persistent program: (code, the answer's bytes in `answer`, their count). Codes as for `value`; 2 also when the program is gone.
fn persistent_ask[&h, &c, &z, &v](heap: &!h Heap, clock: &c Clock, link: &!z option.Option[persist.Link], point: &v [float]) -> [heap, clock, poll, pipe_write, pipe_read] (int, buffer.Buffer, int) {
    let line = point_line(heap, point);
    var code = 2;
    var answer = buffer.empty(heap, 0);
    var length = 0;
    borrow line as &lr in {
        match link {
            option.Option::Some(l) => {
                let wait = l.timeout;
                let (c2, got, nl) = persist.ask(heap, clock, l, buffer.bytes(lr), 65536, wait);
                buffer.drop(heap, answer);
                answer = got;
                code = c2;
                length = nl;
            }
            option.Option::None => {
                code = 1;
            }
        }
    }
    buffer.drop(heap, line);
    return (code, answer, length);
}

fn persistent_value[&h, &c, &z, &v](heap: &!h Heap, clock: &c Clock, link: &!z option.Option[persist.Link], point: &v [float]) -> [heap, clock, poll, pipe_write, pipe_read] (int, float) {
    let (code, answer, length) = persistent_ask(heap, clock, link, point);
    var out = 0.0;
    var result = code;
    if code == 0 {
        borrow answer as &ar in {
            let (c3, v3) = number_of(buffer.bytes(ar)[0..length]);
            result = c3;
            out = v3;
        }
    }
    buffer.drop(heap, answer);
    return (result, out);
}

fn persistent_value_gradient[&h, &c, &z, &v, &g](heap: &!h Heap, clock: &c Clock, link: &!z option.Option[persist.Link], point: &v [float], grad: &!g [float]) -> [heap, clock, poll, pipe_write, pipe_read] (int, float) {
    let (code, answer, length) = persistent_ask(heap, clock, link, point);
    var out = 0.0;
    var result = code;
    if code == 0 {
        borrow answer as &ar in {
            region r2 {
                let nums = alloc_slice[r2](len(point) + 1, 0.0);
                let count = numbers_of(buffer.bytes(ar)[0..length], nums);
                if count != len(point) + 1 {
                    result = 3;
                } else {
                    out = nums[0];
                    var all = true;
                    var j = 0;
                    while j <= len(point) {
                        if nums[j] - nums[j] != 0.0 {
                            all = false;
                        }
                        j = j + 1;
                    }
                    if !all {
                        result = 4;
                    } else {
                        result = 0;
                        j = 0;
                        while j < len(point) {
                            grad[j] = nums[1 + j];
                            j = j + 1;
                        }
                    }
                }
            }
        }
    }
    buffer.drop(heap, answer);
    return (result, out);
}

pub fn value[&h, &i, &x, &c, &p, &a, &v, &z](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, link: &!z option.Option[persist.Link], kind: int, exe: &p [byte], argv: &a [byte], point: &v [float]) -> [heap, exec(""), clock, poll, pipe_write, pipe_read] (int, float) {
    if kind == 0 {
        return spawn_value(heap, io, exec, clock, exe, argv, point);
    }
    if kind == 5 {
        return persistent_value(heap, clock, link, point);
    }
    var total = 0.0;
    var k = 0;
    if kind == 1 {
        while k < len(point) {
            total = total + point[k] * point[k];
            k = k + 1;
        }
    } else if kind == 2 {
        // 100 (x[i+1] - x[i]^2)^2 + (1 - x[i])^2, summed in order: scipy's `rosen`
        while k + 1 < len(point) {
            let t = point[k + 1] - point[k] * point[k];
            let u = 1.0 - point[k];
            let term = 100.0 * (t * t) + u * u;
            if k == 0 {
                total = term;
            } else {
                total = total + term;
            }
            k = k + 1;
        }
    } else if kind == 3 {
        while k < len(point) {
            let d = point[k] - float_of(k);
            total = total + d * d;
            k = k + 1;
        }
    } else {
        // sum of (k + 1) |x_k - k|: a minimum with a corner, which makes the simplex shrink
        while k < len(point) {
            var d = point[k] - float_of(k);
            if d < 0.0 {
                d = 0.0 - d;
            }
            total = total + float_of(k + 1) * d;
            k = k + 1;
        }
    }
    if total - total != 0.0 {
        return (4, 0.0);
    }
    return (0, total);
}

// ---- value and gradient (BFGS, docs/design.md section 9) --------------------------------------------------------------------------------------------------------

// does the objective have a gradient? Every kind but `absolute` does.
pub fn has_gradient(kind: int) -> [] bool {
    return kind != 4;
}

// the numbers of `text`, white space separated, into `out` (as many as it holds): how many there were, or -1 when something is not a number or there are more than `out` holds
fn numbers_of[&s, &o](text: &s [byte], out: &!o [float]) -> [] int {
    var count = 0;
    var k = 0;
    while k < len(text) {
        while k < len(text) && (int_of(text[k]) == ' ' || int_of(text[k]) == 10 || int_of(text[k]) == 13 || int_of(text[k]) == 9) {
            k = k + 1;
        }
        if k < len(text) {
            let start = k;
            while k < len(text) && int_of(text[k]) != ' ' && int_of(text[k]) != 10 && int_of(text[k]) != 13 && int_of(text[k]) != 9 {
                k = k + 1;
            }
            let (code, v) = number_of(text[start..k]);
            if code != 0 || count >= len(out) {
                return 0 - 1;
            }
            out[count] = v;
            count = count + 1;
        }
    }
    return count;
}

fn spawn_value_gradient[&h, &i, &x, &c, &p, &a, &v, &g](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, exe: &p [byte], argv: &a [byte], point: &v [float], grad: &!g [float]) -> [heap, exec(""), clock, poll] (int, float) {
    var line = buffer.empty(heap, 64);
    var k = 0;
    while k < len(point) {
        if k > 0 {
            line = buffer.push(heap, line, byte_of(' '));
        }
        region r {
            let scratch = alloc_slice[r](32, byte_of(0));
            let n = fmt.float_into(scratch, point[k]);
            if n > 0 {
                line = buffer.append(heap, line, scratch[0..n]);
            }
        }
        k = k + 1;
    }
    line = buffer.push(heap, line, byte_of(10));
    var code = 1;
    var out = 0.0;
    match process.channels_with_errors() {
        process.ChannelsWithErrors::Failed(e) => {
            code = 1;
        }
        process.ChannelsWithErrors::Ok(to_child, child_in, from_child, child_out, from_errors, child_errors) => {
            match exec_spawn(exec, exe, argv, "PATH=/usr/local/bin:/usr/bin:/bin\0HOME=/tmp\0", Stdio::Pipe(child_in), Stdio::Pipe(child_out), Stdio::Pipe(child_errors)) {
                Spawned::Failed(e) => {
                    process.close(to_child, from_child);
                    pipe_close(from_errors);
                    code = 1;
                }
                Spawned::Ok(child) => {
                    var input = buffer.empty(heap, 0);
                    borrow line as &lr in {
                        input = buffer.append(heap, input, buffer.bytes(lr));
                    }
                    borrow input as &nr in {
                        let (got, errors, ran) = process.capture_both(heap, clock, child, to_child, from_child, from_errors, buffer.bytes(nr), 65536, 65536, 3600000);
                        if status_of(ran) != 0 {
                            code = 2;
                        } else {
                            borrow got as &gr in {
                                // the value, then the gradient: n + 1 numbers
                                region r2 {
                                    let nums = alloc_slice[r2](len(point) + 1, 0.0);
                                    let count = numbers_of(buffer.bytes(gr), nums);
                                    if count != len(point) + 1 {
                                        code = 3;
                                    } else {
                                        out = nums[0];
                                        var all = true;
                                        var j = 0;
                                        while j <= len(point) {
                                            if nums[j] - nums[j] != 0.0 {
                                                all = false;
                                            }
                                            j = j + 1;
                                        }
                                        if !all {
                                            code = 4;
                                        } else {
                                            code = 0;
                                            j = 0;
                                            while j < len(point) {
                                                grad[j] = nums[1 + j];
                                                j = j + 1;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        buffer.drop(heap, got);
                        buffer.drop(heap, errors);
                    }
                    buffer.drop(heap, input);
                }
            }
        }
    }
    buffer.drop(heap, line);
    return (code, out);
}

// The value and the gradient at `point`: (code, value), the gradient in `grad`. Codes as for `value`, and 5 for an objective without a gradient.
pub fn value_gradient[&h, &i, &x, &c, &p, &a, &v, &g, &z](heap: &!h Heap, io: &!i Io, exec: &x Exec(""), clock: &c Clock, link: &!z option.Option[persist.Link], kind: int, exe: &p [byte], argv: &a [byte], point: &v [float], grad: &!g [float]) -> [heap, exec(""), clock, poll, pipe_write, pipe_read] (int, float) {
    if kind == 0 {
        return spawn_value_gradient(heap, io, exec, clock, exe, argv, point, grad);
    }
    if kind == 5 {
        return persistent_value_gradient(heap, clock, link, point, grad);
    }
    if kind == 4 {
        return (5, 0.0);
    }
    let (code, f) = value(heap, io, exec, clock, link, kind, exe, argv, point);
    if code != 0 {
        return (code, f);
    }
    let n = len(point);
    var k = 0;
    if kind == 1 {
        while k < n {
            grad[k] = 2.0 * point[k];
            k = k + 1;
        }
    } else if kind == 3 {
        while k < n {
            grad[k] = 2.0 * (point[k] - float_of(k));
            k = k + 1;
        }
    } else {
        // scipy's `rosen_der`: the first, the last and the interior components with its formulas, in its order of operations
        if n < 2 {
            return (5, 0.0);
        }
        grad[0] = (0.0 - 400.0) * point[0] * (point[1] - point[0] * point[0]) - 2.0 * (1.0 - point[0]);
        grad[n - 1] = 200.0 * (point[n - 1] - point[n - 2] * point[n - 2]);
        k = 1;
        while k + 1 < n {
            let xm = point[k];
            let xm_m1 = point[k - 1];
            let xm_p1 = point[k + 1];
            grad[k] = 200.0 * (xm - xm_m1 * xm_m1) - 400.0 * (xm_p1 - xm * xm) * xm - 2.0 * (1.0 - xm);
            k = k + 1;
        }
    }
    return (0, f);
}
