edition 7;

module opt.dcsrch;

// MINPACK-2's `dcsrch` and `dcstep` (Moré and Thuente's line search), as scipy 1.18 ports them in `scipy/optimize/_dcsrch.py`: the same operations in the same order. `iterate` is `DCSRCH._iterate`; the loop
// that evaluates the function between calls is in `bfgs.cho`. The state is a vector of floats `ds`:
//
//   0 stx  1 fx  2 gx  3 sty  4 fy  5 gy  6 stmin  7 stmax  8 finit  9 ginit  10 gtest  11 width  12 width1  13 brackt (0 or 1)  14 stage
//   15 ftol  16 gtol  17 xtol  18 stpmin  19 stpmax
//
// and a task is 0 START, 1 FG (evaluate the function and the derivative at `stp`), 2 CONVERGENCE, 3 WARNING, 4 ERROR.

pub fn state_size() -> [] int {
    return 20;
}

pub fn task_start() -> [] int {
    return 0;
}

pub fn task_fg() -> [] int {
    return 1;
}

pub fn task_convergence() -> [] int {
    return 2;
}

pub fn task_warning() -> [] int {
    return 3;
}

pub fn task_error() -> [] int {
    return 4;
}

// Python's `min(a, b)` and `max(a, b)`: the first argument unless the second is strictly smaller (larger)
pub fn pmin(a: float, b: float) -> [] float {
    if b < a {
        return b;
    }
    return a;
}

pub fn pmax(a: float, b: float) -> [] float {
    if b > a {
        return b;
    }
    return a;
}

fn absolute(v: float) -> [] float {
    if v < 0.0 {
        return 0.0 - v;
    }
    return v;
}

// `np.sign`: 1, -1, 0, and NaN for NaN
fn sign(v: float) -> [] float {
    if v > 0.0 {
        return 1.0;
    }
    if v < 0.0 {
        return 0.0 - 1.0;
    }
    return v;
}

// `np.clip(x, lo, hi)`: NaN stays NaN
pub fn clip(x: float, lo: float, hi: float) -> [] float {
    if x != x {
        return x;
    }
    var v = x;
    if v < lo {
        v = lo;
    }
    if v > hi {
        v = hi;
    }
    return v;
}

// `max(abs(a), abs(b), abs(c))` as Python evaluates it
fn max3(a: float, b: float, c: float) -> [] float {
    var m = absolute(a);
    if absolute(b) > m {
        m = absolute(b);
    }
    if absolute(c) > m {
        m = absolute(c);
    }
    return m;
}

// The safeguarded step and the updated interval: (stx, fx, dx, sty, fy, dy, stp, brackt).
pub fn dcstep(stx0: float, fx0: float, dx0: float, sty0: float, fy0: float, dy0: float, stp0: float, fp: float, dp: float, brackt0: int, stpmin: float, stpmax: float) -> [] (float, float, float, float, float, float, float, int) {
    var stx = stx0;
    var fx = fx0;
    var dx = dx0;
    var sty = sty0;
    var fy = fy0;
    var dy = dy0;
    let stp = stp0;
    var brackt = brackt0;
    let sgnd = sign(dp) * sign(dx);
    var stpf = 0.0;
    if fp > fx {
        let theta = 3.0 * (fx - fp) / (stp - stx) + dx + dp;
        let s = max3(theta, dx, dp);
        var gamma = s * sqrt((theta / s) * (theta / s) - (dx / s) * (dp / s));
        if stp < stx {
            gamma = gamma * (0.0 - 1.0);
        }
        let p = (gamma - dx) + theta;
        let q = ((gamma - dx) + gamma) + dp;
        let r = p / q;
        let stpc = stx + r * (stp - stx);
        let stpq = stx + ((dx / ((fx - fp) / (stp - stx) + dx)) / 2.0) * (stp - stx);
        if absolute(stpc - stx) <= absolute(stpq - stx) {
            stpf = stpc;
        } else {
            stpf = stpc + (stpq - stpc) / 2.0;
        }
        brackt = 1;
    } else if sgnd < 0.0 {
        let theta = 3.0 * (fx - fp) / (stp - stx) + dx + dp;
        let s = max3(theta, dx, dp);
        var gamma = s * sqrt((theta / s) * (theta / s) - (dx / s) * (dp / s));
        if stp > stx {
            gamma = gamma * (0.0 - 1.0);
        }
        let p = (gamma - dp) + theta;
        let q = ((gamma - dp) + gamma) + dx;
        let r = p / q;
        let stpc = stp + r * (stx - stp);
        let stpq = stp + (dp / (dp - dx)) * (stx - stp);
        if absolute(stpc - stp) > absolute(stpq - stp) {
            stpf = stpc;
        } else {
            stpf = stpq;
        }
        brackt = 1;
    } else if absolute(dp) < absolute(dx) {
        let theta = 3.0 * (fx - fp) / (stp - stx) + dx + dp;
        let s = max3(theta, dx, dp);
        // `max(0, ...)` of Python: 0 unless the radicand is positive (NaN gives 0)
        var rad = (theta / s) * (theta / s) - (dx / s) * (dp / s);
        if !(rad > 0.0) {
            rad = 0.0;
        }
        var gamma = s * sqrt(rad);
        if stp > stx {
            gamma = 0.0 - gamma;
        }
        let p = (gamma - dp) + theta;
        let q = (gamma + (dx - dp)) + gamma;
        let r = p / q;
        var stpc = stpmin;
        if r < 0.0 && gamma != 0.0 {
            stpc = stp + r * (stx - stp);
        } else if stp > stx {
            stpc = stpmax;
        }
        let stpq = stp + (dp / (dp - dx)) * (stx - stp);
        if brackt != 0 {
            if absolute(stpc - stp) < absolute(stpq - stp) {
                stpf = stpc;
            } else {
                stpf = stpq;
            }
            if stp > stx {
                stpf = pmin(stp + 0.66 * (sty - stp), stpf);
            } else {
                stpf = pmax(stp + 0.66 * (sty - stp), stpf);
            }
        } else {
            if absolute(stpc - stp) > absolute(stpq - stp) {
                stpf = stpc;
            } else {
                stpf = stpq;
            }
            stpf = clip(stpf, stpmin, stpmax);
        }
    } else {
        if brackt != 0 {
            let theta = 3.0 * (fp - fy) / (sty - stp) + dy + dp;
            let s = max3(theta, dy, dp);
            var gamma = s * sqrt((theta / s) * (theta / s) - (dy / s) * (dp / s));
            if stp > sty {
                gamma = 0.0 - gamma;
            }
            let p = (gamma - dp) + theta;
            let q = ((gamma - dp) + gamma) + dy;
            let r = p / q;
            stpf = stp + r * (sty - stp);
        } else if stp > stx {
            stpf = stpmax;
        } else {
            stpf = stpmin;
        }
    }
    if fp > fx {
        sty = stp;
        fy = fp;
        dy = dp;
    } else {
        if sgnd < 0.0 {
            sty = stx;
            fy = fx;
            dy = dx;
        }
        stx = stp;
        fx = fp;
        dx = dp;
    }
    return (stx, fx, dx, sty, fy, dy, stpf, brackt);
}

// One call of `DCSRCH._iterate`: the new step to try (or the final one), the values, and the task.
pub fn iterate[&d](ds: &!d [float], stp0: float, f: float, g: float, task0: int) -> [] (float, float, float, int) {
    var stp = stp0;
    var task = task0;
    let p5 = 0.5;
    let p66 = 0.66;
    let xtrapl = 1.1;
    let xtrapu = 4.0;
    if task == 0 {
        if stp < ds[18] {
            task = 4;
        }
        if stp > ds[19] {
            task = 4;
        }
        if g >= 0.0 {
            task = 4;
        }
        if ds[15] < 0.0 {
            task = 4;
        }
        if ds[16] < 0.0 {
            task = 4;
        }
        if ds[17] < 0.0 {
            task = 4;
        }
        if ds[18] < 0.0 {
            task = 4;
        }
        if ds[19] < ds[18] {
            task = 4;
        }
        if task == 4 {
            return (stp, f, g, task);
        }
        ds[13] = 0.0;
        ds[14] = 1.0;
        ds[8] = f;
        ds[9] = g;
        ds[10] = ds[15] * ds[9];
        ds[11] = ds[19] - ds[18];
        ds[12] = ds[11] / p5;
        ds[0] = 0.0;
        ds[1] = ds[8];
        ds[2] = ds[9];
        ds[3] = 0.0;
        ds[4] = ds[8];
        ds[5] = ds[9];
        ds[6] = 0.0;
        ds[7] = stp + xtrapu * stp;
        return (stp, f, g, 1);
    }
    let ftest = ds[8] + stp * ds[10];
    if ds[14] == 1.0 && f <= ftest && g >= 0.0 {
        ds[14] = 2.0;
    }
    if ds[13] != 0.0 && (stp <= ds[6] || stp >= ds[7]) {
        task = 3;
    }
    if ds[13] != 0.0 && ds[7] - ds[6] <= ds[17] * ds[7] {
        task = 3;
    }
    if stp == ds[19] && f <= ftest && g <= ds[10] {
        task = 3;
    }
    if stp == ds[18] && (f > ftest || g >= ds[10]) {
        task = 3;
    }
    if f <= ftest && absolute(g) <= ds[16] * (0.0 - ds[9]) {
        task = 2;
    }
    if task == 3 || task == 2 {
        return (stp, f, g, task);
    }
    var bracket = 0;
    if ds[13] != 0.0 {
        bracket = 1;
    }
    if ds[14] == 1.0 && f <= ds[1] && f > ftest {
        let fm = f - stp * ds[10];
        let fxm = ds[1] - ds[0] * ds[10];
        let fym = ds[4] - ds[3] * ds[10];
        let gm = g - ds[10];
        let gxm = ds[2] - ds[10];
        let gym = ds[5] - ds[10];
        let (stx, fxm2, gxm2, sty, fym2, gym2, stpn, br) = dcstep(ds[0], fxm, gxm, ds[3], fym, gym, stp, fm, gm, bracket, ds[6], ds[7]);
        ds[0] = stx;
        ds[3] = sty;
        stp = stpn;
        bracket = br;
        ds[1] = fxm2 + ds[0] * ds[10];
        ds[4] = fym2 + ds[3] * ds[10];
        ds[2] = gxm2 + ds[10];
        ds[5] = gym2 + ds[10];
    } else {
        let (stx, fx, gx, sty, fy, gy, stpn, br) = dcstep(ds[0], ds[1], ds[2], ds[3], ds[4], ds[5], stp, f, g, bracket, ds[6], ds[7]);
        ds[0] = stx;
        ds[1] = fx;
        ds[2] = gx;
        ds[3] = sty;
        ds[4] = fy;
        ds[5] = gy;
        stp = stpn;
        bracket = br;
    }
    ds[13] = float_of(bracket);
    if bracket != 0 {
        if absolute(ds[3] - ds[0]) >= p66 * ds[12] {
            stp = ds[0] + p5 * (ds[3] - ds[0]);
        }
        ds[12] = ds[11];
        ds[11] = absolute(ds[3] - ds[0]);
    }
    if bracket != 0 {
        ds[6] = pmin(ds[0], ds[3]);
        ds[7] = pmax(ds[0], ds[3]);
    } else {
        ds[6] = stp + xtrapl * (stp - ds[0]);
        ds[7] = stp + xtrapu * (stp - ds[0]);
    }
    stp = clip(stp, ds[18], ds[19]);
    if bracket != 0 && (stp <= ds[6] || stp >= ds[7]) || bracket != 0 && ds[7] - ds[6] <= ds[17] * ds[7] {
        stp = ds[0];
    }
    return (stp, f, g, 1);
}
