edition 7;

module opt.lists;

import std.json;

// Numbers on the command line: `1,2.5,-3e-2`, and the words `inf` and `-inf` (written as +-1e300, the box that no real point leaves).

// how many numbers `text` holds (0 for an empty text)
pub fn count[&s](text: &s [byte]) -> [] int {
    if len(text) == 0 {
        return 0;
    }
    var n = 1;
    var k = 0;
    while k < len(text) {
        if int_of(text[k]) == ',' {
            n = n + 1;
        }
        k = k + 1;
    }
    return n;
}

fn is_word[&s](tok: &s [byte], a: &static [byte]) -> [] bool {
    if len(tok) != len(a) {
        return false;
    }
    var k = 0;
    while k < len(tok) {
        if tok[k] != a[k] {
            return false;
        }
        k = k + 1;
    }
    return true;
}

// the number `tok` writes: (true, x), or (false, 0)
pub fn number[&s](tok: &s [byte]) -> [] (bool, float) {
    if is_word(tok, "inf") {
        return (true, 1.0e300);
    }
    if is_word(tok, "-inf") {
        return (true, 0.0 - 1.0e300);
    }
    if len(tok) == 0 {
        return (false, 0.0);
    }
    var ok = false;
    var out = 0.0;
    region r {
        let src = alloc_slice[r](len(tok) + 2, byte_of(0));
        src[0] = byte_of('[');
        var k = 0;
        while k < len(tok) {
            src[1 + k] = tok[k];
            k = k + 1;
        }
        src[len(tok) + 1] = byte_of(']');
        let all = src[0..len(tok) + 2];
        let tape = alloc_slice[r](json.tape_len(all), 0);
        if json.parse(all, tape) > 0 && json.is_number(tape, 1) && json.count(tape, 0) == 1 {
            out = json.to_float(all, tape, 1);
            ok = out - out == 0.0;
        }
    }
    return (ok, out);
}

// Read the numbers of `text` into `out` (which has `count(text)` places); 0, or the position (from 1) of the first that is not a number.
pub fn read_into[&s, &o](text: &s [byte], out: &!o [float]) -> [] int {
    var at = 0;
    var start = 0;
    var k = 0;
    while k <= len(text) && len(text) > 0 {
        if k == len(text) || int_of(text[k]) == ',' {
            let (ok, v) = number(text[start..k]);
            if !ok {
                return at + 1;
            }
            out[at] = v;
            at = at + 1;
            start = k + 1;
        }
        k = k + 1;
    }
    return 0;
}

// the non-negative integer `text` writes, or -1
pub fn natural[&s](text: &s [byte]) -> [] int {
    if len(text) == 0 || len(text) > 9 {
        return 0 - 1;
    }
    var v = 0;
    var k = 0;
    while k < len(text) {
        let c = int_of(text[k]);
        if c < '0' || c > '9' {
            return 0 - 1;
        }
        v = v * 10 + (c - '0');
        k = k + 1;
    }
    return v;
}
